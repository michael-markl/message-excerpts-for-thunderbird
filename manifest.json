{
  "manifest_version": 3,
  "name": "Message Excerpt Card View",
  "description": "Modifies the Thunderbird Card View to display a message excerpt.",
  "version": "1.0",
  "author": "Antigravity",
  "browser_specific_settings": {
    "gecko": {
      "id": "excerpt-card-view@example.com",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "messagesRead"
  ],
  "experiment_apis": {
    "messageExcerpts": {
      "schema": "api/messageExcerpts/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["messageExcerpts"]],
        "script": "api/messageExcerpts/implementation.js"
      }
    }
  }
}
