{
  "manifest_version": 3,
  "name": "Thunderbird Message Excerpts",
  "description": "Displays a message excerpt after the subject.",
  "version": "0.1.0",
  "author": "Michael Markl",
  "homepage_url": "https://github.com/michael-markl/thunderbird-message-excerpts",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-message-excerpts@michael-markl.de",
      "strict_min_version": "128.0",
      "strict_max_version": "153.*"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "64": "icon-64.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "messagesRead"
  ],
  "experiment_apis": {
    "messageExcerpts": {
      "schema": "api/messageExcerpts/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["messageExcerpts"]],
        "script": "api/messageExcerpts/implementation.js"
      }
    }
  }
}
