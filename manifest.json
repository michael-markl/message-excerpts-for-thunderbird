{
  "manifest_version": 2,
  "name": "Message Excerpt Card View",
  "description": "Modifies the Thunderbird Card View to display a message excerpt.",
  "version": "1.0",
  "author": "Antigravity",
  "applications": {
    "gecko": {
      "id": "excerpt-card-view@example.com",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "messagesRead"
  ],
  "experiment_apis": {
    "customColumn": {
      "schema": "api/customColumn/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["customColumn"]],
        "script": "api/customColumn/implementation.js"
      }
    }
  }
}
