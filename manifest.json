{
  "manifest_version": 3,
  "name": "Message Excerpts for Thunderbird",
  "description": "Displays a message excerpt after the subject.",
  "version": "0.1.3",
  "author": "Michael Markl",
  "homepage_url": "https://github.com/michael-markl/message-excerpts-for-thunderbird",
  "browser_specific_settings": {
    "gecko": {
      "id": "message-excerpts-for-thunderbird@michael-markl.de",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "64": "icon-64.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "messagesRead"
  ],
  "experiment_apis": {
    "messageExcerpts": {
      "schema": "api/messageExcerpts/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["messageExcerpts"]],
        "script": "api/messageExcerpts/implementation.js"
      }
    }
  }
}
